{
  "openapi": "3.1.0",
  "info": {
    "title": "Falcon PQC FALSIGN Rule Evaluation API",
    "description": "Illustrative threshold and keyword evaluator. Does not perform FN-DSA/Falcon signing or verification. Runtime OpenAPI is authoritative at /openapi.json.",
    "version": "3.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve browser console",
        "responses": {
          "200": {
            "description": "HTML console"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory metrics (JSON, not Prometheus text)",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate task rules and log HMAC metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation dossier"
          },
          "422": {
            "description": "Validation or identifier screening failure"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock-only responder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Sensitive identifier blocked"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Fetch and verify in-memory HMAC audit metadata",
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required to match server-side AUDIT_READ_TOKEN; endpoint is disabled if token is not configured."
          }
        ],
        "responses": {
          "200": {
            "description": "Signed metadata and chain verification result"
          },
          "403": {
            "description": "Disabled or unauthorized"
          }
        }
      }
    }
  }
}
